<%- include('Layout/head.ejs') %>
    <main>
        <h2><%= data.title %></h2>
        <p>Date created: <%= data.year %>-<%= data.month %>-<%= data.day %></p>
        <p>Comics #: <%= data.num %> | View count: <%= count %></p>
        <div class="buttons">
            <a href="/<%= prev %>"><button <%= data.num <= 1 ? 'disabled' : '' %>>Prev</button></a>
            <a href="/<%= random %>"><button>Random</button></a>
            <a href="/<%= next %>"><button <%= data.num >= maxNum ? 'disabled' : '' %>>Next</button></a>
        </div>
        <img src="<%= data.img %>" alt="<%= data.alt %>" title="<%= data.alt %>">
        <div class="transcript">
            <% if (transcript.length) { %>
                <h3>Transcript</h3>
                <% for (let words of transcript) { %>
                    <p><%= words %></p>
                <% } %>
            <% } %>
        </div>
        <a href="/"><button>Back to the latest Page</button></a>
    </main>
<%- include('Layout/foot.ejs') %>
